candlepin.consumer_system_name_pattern=.+

candlepin.environment_content_filtering=true
candlepin.auth.basic.enable=false
candlepin.auth.trusted.enable=false

candlepin.db.database_manage_on_startup=Manage

candlepin.auth.oauth.enable=true
candlepin.auth.oauth.consumer.katello.secret={{ candlepin_oauth_secret }}

module.config.adapter_module=org.candlepin.katello.KatelloModule

{% if certificates_algorithm_sets | length > 0 %}
candlepin.ca_key=/etc/candlepin/certs/candlepin-{{ _candlepin_algorithms[certificates_algorithm_type].file_suffix }}-ca.key
candlepin.ca_cert=/etc/candlepin/certs/candlepin-{{ _candlepin_algorithms[certificates_algorithm_type].file_suffix }}-ca.crt

candlepin.crypto.schemes={{ certificates_algorithm_sets | map('extract', _candlepin_algorithms) | map(attribute='scheme_id') | list | join(',') }}
candlepin.crypto.default_scheme=legacy

{% for algorithm in certificates_algorithm_sets %}
{% set _type = _candlepin_algorithms[algorithm].file_suffix %}
{% set sid = _candlepin_algorithms[algorithm].scheme_id %}
candlepin.crypto.scheme.{{ sid }}.cert=/etc/candlepin/certs/candlepin-{{ _type }}-ca.crt
candlepin.crypto.scheme.{{ sid }}.key=/etc/candlepin/certs/candlepin-{{ _type }}-ca.key
candlepin.crypto.scheme.{{ sid }}.signature_algorithm={{ _candlepin_algorithms[algorithm].scheme_signature }}
candlepin.crypto.scheme.{{ sid }}.key_algorithm={{ _candlepin_algorithms[algorithm].scheme_key }}
{% if _candlepin_algorithms[algorithm].scheme_key_size is defined and _candlepin_algorithms[algorithm].scheme_key_size %}
candlepin.crypto.scheme.{{ sid }}.key_size={{ _candlepin_algorithms[algorithm].scheme_key_size }}
{% endif %}

{% endfor %}
{% else %}
candlepin.ca_key=/etc/candlepin/certs/candlepin-ca.key
candlepin.ca_cert=/etc/candlepin/certs/candlepin-ca.crt
{% if _candlepin_single_algorithm_ca_key_info.type != 'RSA' %}

# The CA key is not RSA, so redefine Candlepin's built-in "legacy" crypto scheme
# to match; without this Candlepin assumes SHA256withRSA and fails to start.
candlepin.crypto.scheme.legacy.key_algorithm={{ _candlepin_algorithms[_candlepin_single_algorithm_ca_key_info.type].scheme_key }}
candlepin.crypto.scheme.legacy.signature_algorithm={{ _candlepin_algorithms[_candlepin_single_algorithm_ca_key_info.type].scheme_signature }}
{% if _candlepin_algorithms[_candlepin_single_algorithm_ca_key_info.type].scheme_key_size is defined and _candlepin_algorithms[_candlepin_single_algorithm_ca_key_info.type].scheme_key_size %}
candlepin.crypto.scheme.legacy.key_size={{ _candlepin_algorithms[_candlepin_single_algorithm_ca_key_info.type].scheme_key_size }}
{% endif %}
{% endif %}
{% endif %}

candlepin.async.jobs.ExpiredPoolsCleanupJob.schedule=0 0 0 * * ?

jpa.config.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
jpa.config.hibernate.hbm2ddl.auto=validate
jpa.config.hibernate.connection.username={{ candlepin_database_user }}
jpa.config.hibernate.connection.password={{ candlepin_database_password }}
jpa.config.hibernate.connection.driver_class=org.postgresql.Driver
jpa.config.hibernate.connection.url=jdbc:postgresql://{{ candlepin_database_host }}:{{ candlepin_database_port }}/{{ candlepin_database_name }}?sslmode={{ candlepin_database_ssl_mode }}{% if candlepin_database_ssl_ca is defined %}&sslrootcert={{ candlepin_database_ssl_ca_path }}{% endif %}


org.quartz.jobStore.misfireThreshold=60000
org.quartz.jobStore.useProperties=false
org.quartz.jobStore.dataSource=myDS
org.quartz.jobStore.tablePrefix=QRTZ_
org.quartz.jobStore.class=org.quartz.impl.jdbcjobstore.JobStoreTX
org.quartz.jobStore.driverDelegateClass=org.quartz.impl.jdbcjobstore.PostgreSQLDelegate

org.quartz.dataSource.myDS.driver=org.postgresql.Driver
org.quartz.dataSource.myDS.user={{ candlepin_database_user }}
org.quartz.dataSource.myDS.password={{ candlepin_database_password }}
org.quartz.dataSource.myDS.maxConnections=5
org.quartz.dataSource.myDS.URL=jdbc:postgresql://{{ candlepin_database_host }}:{{ candlepin_database_port }}/{{ candlepin_database_name }}?sslmode={{ candlepin_database_ssl_mode }}{% if candlepin_database_ssl_ca is defined %}&sslrootcert={{ candlepin_database_ssl_ca_path }}{% endif %}
