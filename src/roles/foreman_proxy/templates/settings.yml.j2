:settings_directory: /etc/foreman-proxy/settings.d

:foreman_url: {{ foreman_proxy_foreman_server_url }}
:permitted_hosts: {{ foreman_proxy_permitted_hosts | to_json }}
:trusted_hosts:
{% for host in foreman_proxy_trusted_hosts %}
  - {{ host }}
{% endfor %}

:https_port: {{ foreman_proxy_https_port }}
:ssl_ca_file: /etc/foreman-proxy/ssl_ca.pem
:ssl_certificate: /etc/foreman-proxy/ssl_cert_{{ foreman_proxy_primary_cert_type }}.pem
:ssl_private_key: /etc/foreman-proxy/ssl_key_{{ foreman_proxy_primary_cert_type }}.pem
{% if foreman_proxy_additional_cert_types | length > 0 %}
:ssl_additional_certificates:
{% for t in foreman_proxy_additional_cert_types %}
- :cert: /etc/foreman-proxy/ssl_cert_{{ t }}.pem
  :key: /etc/foreman-proxy/ssl_key_{{ t }}.pem
{% endfor %}
{% endif %}

:foreman_ssl_ca: /etc/foreman-proxy/foreman_ssl_ca.pem
:foreman_ssl_cert: /etc/foreman-proxy/foreman_ssl_cert.pem
:foreman_ssl_key: /etc/foreman-proxy/foreman_ssl_key.pem

:bind_host: '*'

:log_level: {{ foreman_proxy_log_level | upper }}
:log_file: JOURNAL
:log_buffer: 2000
:log_buffer_errors: 1000
